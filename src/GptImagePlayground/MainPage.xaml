<Page
    x:Class="GptImagePlayground.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GptImagePlayground"
    Loaded="Page_Loaded">
    <Page.Resources>
        <local:ThumbnailConverter x:Key="ThumbnailConverter" />
        <local:LocalizedStrings x:Key="Strings" />
    </Page.Resources>
    <Grid Padding="24,8,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image Width="48" Height="48" VerticalAlignment="Center" AutomationProperties.Name="{Binding [AppIconName], Source={StaticResource Strings}}">
                    <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/AppIcon.svg" RasterizePixelWidth="96" RasterizePixelHeight="96" /></Image.Source>
                </Image>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="GPT-image-2.5 Playground" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [Subtitle], Source={StaticResource Strings}}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <TextBlock Grid.Column="1" Text="Microsoft Foundry" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <InfoBar Grid.Row="1" IsOpen="{x:Bind Vm.HasError, Mode=OneWay}" Severity="Error" IsClosable="False"
                 Title="{Binding [ErrorTitle], Source={StaticResource Strings}}">
            <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{x:Bind Vm.Error, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           AutomationProperties.AutomationId="ErrorDetails" AutomationProperties.LiveSetting="Polite" />
            </ScrollViewer>
        </InfoBar>
        <Pivot x:Name="WorkspaceTabs" Grid.Row="2" AutomationProperties.AutomationId="WorkspaceTabs">
            <PivotItem Header="{Binding [ComposeTab], Source={StaticResource Strings}}" AutomationProperties.AutomationId="ComposeTab">
                <Grid x:Name="ComposeGrid" ColumnSpacing="24" RowSpacing="16">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="Wide">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
                            </VisualState>
                            <VisualState x:Name="Narrow">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="EditorColumn.Width" Value="*" />
                                    <Setter Target="PreviewColumn.Width" Value="0" />
                                    <Setter Target="PreviewPanel.(Grid.Column)" Value="0" />
                                    <Setter Target="PreviewPanel.(Grid.Row)" Value="1" />
                                    <Setter Target="PreviewRow.Height" Value="260" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn" Width="420" /><ColumnDefinition x:Name="PreviewColumn" Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition x:Name="PreviewRow" Height="0" /></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12" Padding="0,0,8,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [ReferencesHeading], Source={StaticResource Strings}}" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="{Binding [AddImages], Source={StaticResource Strings}}" Click="AddImages_Click" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}"
                                        AutomationProperties.AutomationId="AddImagesButton" />
                            </Grid>
                            <TextBlock Text="{Binding [ReferencesHelp], Source={StaticResource Strings}}"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ListView x:Name="ReferenceList" ItemsSource="{x:Bind Vm.References, Mode=OneWay}" Height="172"
                                      SelectionMode="Single" AllowDrop="True" DragOver="References_DragOver" Drop="References_Drop"
                                      AutomationProperties.AutomationId="ReferenceList" AutomationProperties.Name="{Binding [ReferenceListName], Source={StaticResource Strings}}"
                                      IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailConverter}}" ImageFailed="Thumbnail_ImageFailed"
                                                   Width="64" Height="56" Stretch="Uniform" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding [MoveUp], Source={StaticResource Strings}}" Command="{x:Bind Vm.MoveUpCommand}" CommandParameter="{Binding SelectedItem, ElementName=ReferenceList}"
                                        AutomationProperties.AutomationId="MoveReferenceUpButton" />
                                <Button Content="{Binding [MoveDown], Source={StaticResource Strings}}" Command="{x:Bind Vm.MoveDownCommand}" CommandParameter="{Binding SelectedItem, ElementName=ReferenceList}"
                                        AutomationProperties.AutomationId="MoveReferenceDownButton" />
                                <Button Content="{Binding [RemoveReference], Source={StaticResource Strings}}" Command="{x:Bind Vm.RemoveReferenceCommand}" CommandParameter="{Binding SelectedItem, ElementName=ReferenceList}"
                                        AutomationProperties.AutomationId="RemoveReferenceButton" />
                            </StackPanel>
                            <TextBox Header="{Binding [PromptHeader], Source={StaticResource Strings}}" Text="{x:Bind Vm.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="124" MaxLength="32000"
                                     PlaceholderText="{Binding [PromptPlaceholder], Source={StaticResource Strings}}"
                                     IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}" AutomationProperties.AutomationId="PromptTextBox" />
                            <Expander Header="{Binding [AdvancedSettings], Source={StaticResource Strings}}"
                                      IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      AutomationProperties.AutomationId="AdvancedSettingsExpander">
                                <StackPanel Spacing="12">
                                    <ComboBox Header="{Binding [PresetHeader], Source={StaticResource Strings}}" ItemsSource="{x:Bind Presets}" DisplayMemberPath="Label"
                                              SelectedValuePath="Size" SelectionChanged="Preset_SelectionChanged" SelectedIndex="0"
                                              HorizontalAlignment="Stretch" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}"
                                              AutomationProperties.AutomationId="AspectRatioComboBox" />
                                    <TextBox Header="{Binding [SizeHeader], Source={StaticResource Strings}}"
                                             Text="{x:Bind Vm.Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}" AutomationProperties.AutomationId="SizeTextBox" />
                                    <TextBlock Text="{x:Bind Vm.SizeDescription, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <ComboBox Header="{Binding [QualityHeader], Source={StaticResource Strings}}" ItemsSource="{x:Bind Qualities}" SelectedItem="{x:Bind Vm.Quality, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}" AutomationProperties.AutomationId="QualityComboBox" />
                                        <ComboBox Grid.Column="1" Header="{Binding [FormatHeader], Source={StaticResource Strings}}" ItemsSource="{x:Bind Formats}" SelectedItem="{x:Bind Vm.OutputFormat, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}" AutomationProperties.AutomationId="OutputFormatComboBox" />
                                        <ComboBox Grid.Column="2" Header="{Binding [BackgroundHeader], Source={StaticResource Strings}}" ItemsSource="{x:Bind Backgrounds}" SelectedItem="{x:Bind Vm.Background, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}" AutomationProperties.AutomationId="BackgroundComboBox" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                            <TextBlock Text="{Binding [BillingNotice], Source={StaticResource Strings}}"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="{Binding [Generate], Source={StaticResource Strings}}" Command="{x:Bind Vm.GenerateCommand}" Style="{ThemeResource AccentButtonStyle}"
                                        AutomationProperties.AutomationId="GenerateButton" />
                                <Button Content="{Binding [Cancel], Source={StaticResource Strings}}" Command="{x:Bind Vm.CancelCommand}" AutomationProperties.AutomationId="CancelGenerationButton" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="PreviewPanel" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [PreviewHeading], Source={StaticResource Strings}}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <Button Grid.Column="1" Content="{Binding [SaveAs], Source={StaticResource Strings}}" Click="SaveOutput_Click"
                                        IsEnabled="{x:Bind Vm.HasResult, Mode=OneWay}" AutomationProperties.AutomationId="SaveOutputButton" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <TextBlock x:Name="PreviewPlaceholder" Text="{Binding [PreviewPlaceholder], Source={StaticResource Strings}}" TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Image x:Name="OutputPreview" Stretch="Uniform" AutomationProperties.Name="{Binding [OutputImageName], Source={StaticResource Strings}}" />
                            </Grid>
                            <TextBlock x:Name="OutputDetails" Grid.Row="2" TextWrapping="Wrap" FontSize="12" />
                        </Grid>
                    </Border>
                </Grid>
            </PivotItem>
            <PivotItem Header="{Binding [HistoryTab], Source={StaticResource Strings}}" AutomationProperties.AutomationId="HistoryTab">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="{Binding [ReloadHistory], Source={StaticResource Strings}}" Command="{x:Bind Vm.ReloadHistoryCommand}" AutomationProperties.AutomationId="ReloadHistoryButton" />
                        <Button Content="{Binding [OpenHistory], Source={StaticResource Strings}}" Click="OpenHistory_Click" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}"
                                AutomationProperties.AutomationId="OpenHistoryButton" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind HistoryVm.Items, Mode=OneWay}" SelectedItem="{x:Bind HistoryVm.SelectedItem, Mode=TwoWay}"
                              SelectionMode="Single" AutomationProperties.AutomationId="HistoryList" AutomationProperties.Name="{Binding [HistoryListName], Source={StaticResource Strings}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Image Source="{Binding OutputFile, Converter={StaticResource ThumbnailConverter}}" ImageFailed="Thumbnail_ImageFailed"
                                           Width="128" Height="96" Stretch="Uniform" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Request.Prompt}" MaxLines="3" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ScrollViewer Grid.Row="2" MaxHeight="180">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind HistoryVm.SelectedDetails, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{Binding [HistoryHelp], Source={StaticResource Strings}}"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>
            <PivotItem Header="{Binding [SettingsTab], Source={StaticResource Strings}}" AutomationProperties.AutomationId="SettingsTab">
                <ScrollViewer>
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="16" Padding="0,0,16,24">
                        <ComboBox x:Name="LanguageSelector"
                                  Header="{Binding [LanguageHeader], Source={StaticResource Strings}}"
                                  SelectedValuePath="Tag" SelectionChanged="Language_SelectionChanged"
                                  AutomationProperties.AutomationId="LanguageComboBox">
                            <ComboBoxItem Content="English" Tag="en-US" />
                            <ComboBoxItem Content="日本語" Tag="ja-JP" />
                        </ComboBox>
                        <TextBlock Text="{Binding [LanguageHelp], Source={StaticResource Strings}}" TextWrapping="Wrap" />
                        <TextBlock x:Name="LanguageNotice" Visibility="Collapsed" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding [ConnectionHeading], Source={StaticResource Strings}}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{Binding [ConnectionHelp], Source={StaticResource Strings}}"
                                   TextWrapping="Wrap" />
                        <TextBox Header="{Binding [EndpointHeader], Source={StaticResource Strings}}" PlaceholderText="https://your-resource.services.ai.azure.com/openai/v1/images/generations"
                                 Text="{x:Bind SettingsVm.Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}" AutomationProperties.AutomationId="EndpointTextBox" />
                        <TextBox Header="{Binding [DeploymentHeader], Source={StaticResource Strings}}"
                                 Text="{x:Bind SettingsVm.Deployment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}" AutomationProperties.AutomationId="DeploymentTextBox" />
                        <ComboBox Header="{Binding [CredentialHeader], Source={StaticResource Strings}}"
                                  ItemsSource="{x:Bind CredentialSources}" SelectedItem="{x:Bind SettingsVm.CredentialSource, Mode=TwoWay}"
                                  IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}" AutomationProperties.AutomationId="CredentialSourceComboBox" />
                        <TextBox Header="{Binding [DefaultSizeHeader], Source={StaticResource Strings}}" Text="{x:Bind SettingsVm.DefaultSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}" AutomationProperties.AutomationId="DefaultSizeTextBox" />
                        <ComboBox Header="{Binding [DefaultQualityHeader], Source={StaticResource Strings}}" ItemsSource="{x:Bind Qualities}" SelectedItem="{x:Bind SettingsVm.DefaultQuality, Mode=TwoWay}"
                                  IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}" AutomationProperties.AutomationId="DefaultQualityComboBox" />
                        <Button Content="{Binding [SaveSettings], Source={StaticResource Strings}}" Command="{x:Bind Vm.SaveSettingsCommand}" Style="{ThemeResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="SaveSettingsButton" />
                        <TextBlock Text="{Binding [AuthenticationHelp], Source={StaticResource Strings}}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [ApiHelp], Source={StaticResource Strings}}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" />
                        <TextBlock Text="{x:Bind StorageDescription}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Width="20" Height="20" />
            <TextBlock Grid.Column="1" Text="{x:Bind Vm.Status, Mode=OneWay}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="StatusText" AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Grid>
</Page>
